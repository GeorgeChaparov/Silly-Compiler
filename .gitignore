## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (Mono Auto Generated Files)
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache/options directory
.vs/
.vscode/

# Generated files
*.idb
*.pdb
*.ilk
*.obj
*.exe
*.dll
*.lib
*.app
*.out
*.exp

# Others
*.cachefile
*.dbmdl
*.dbproj.schemaview
*.jfm
*.pfx
*.publishsettings
*.vspscc
*.vssscc
*.v12.suo
*.ncb
*.sdf
*.cache
*.msscci
*.tlh
*.tli
*.tmp
*.log
*.vsidx
*.pgc
*.pgd
*.vsp
*.vsps
*_i.c
*_p.c
*_h.h
*.ipch
*.aps
*.nupkg
*.vsix
*.psess
*.vspx
*.sap
*.docstates

# CMake build directories
[Cc]Make[Bb]uild*/
[Cc]Make[Cc]ache.txt
CMakeFiles/

# Backup & generated files
*.bak
*.swp
*.tmp
*.tlog

# Rider and CLion
.idea/
cmake-build-*/

# Ignore NuGet packages
*.nupkg
*.snupkg
*.nuspec
*.nuproj
project.lock.json
project.fragment.lock.json
artifacts/

# Ignore test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Ignore others
*.opensdf
*.VC.db
*.VC.opendb
